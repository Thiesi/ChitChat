; /usr/pkg/etc/php/8.3/php-fpm.d/APPUSER.conf: one pool per ChitChat instance,
; served by the shared php_fpm83 master. Size pm.* for your host.
[APPUSER]
user = APPUSER
group = APPUSER
listen = /var/run/php-fpm-APPUSER.sock
listen.owner = APPUSER
listen.group = www
listen.mode = 0660
pm = dynamic
pm.max_children = 32
pm.start_servers = 4
pm.min_spare_servers = 2
pm.max_spare_servers = 8
pm.max_requests = 500
clear_env = yes
catch_workers_output = yes
decorate_workers_output = no
security.limit_extensions = .php
env[OPENSSL_CONF] = /usr/share/examples/openssl/openssl.cnf
; ATTACHMENT_MAX_BYTES defaults to 10 MiB; leave room for multipart overhead.
php_admin_value[upload_max_filesize] = 10M
php_admin_value[post_max_size] = 12M
php_admin_value[memory_limit] = 256M
php_admin_value[session.save_path] = /home/APPUSER/sessions
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /home/APPUSER/log/php-error.log
