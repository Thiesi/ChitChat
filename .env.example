APP_ENV=development
APP_DEBUG=1
APP_NAME=ChitChat
APP_VERSION=1.3.0-rc.1

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=chitchat
DB_USER=chitchat
DB_PASSWORD=change-me
DB_SSLMODE=prefer

SESSION_NAME=CHITCHATSESSID
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Legacy login settings remain supported. The named login policy below takes precedence.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCK_MINUTES=15

# Every named policy has a bounded maximum and fixed-window duration.
# See docs/operations/rate-limiting.md before changing production values.
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTRATION_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
RATE_LIMIT_PRIVILEGED_STEP_UP_MAX_ATTEMPTS=10
RATE_LIMIT_PRIVILEGED_STEP_UP_WINDOW_SECONDS=900
RATE_LIMIT_MFA_ASSERTION_MAX_ATTEMPTS=20
RATE_LIMIT_MFA_ASSERTION_WINDOW_SECONDS=900
RATE_LIMIT_MFA_RECOVERY_MAX_ATTEMPTS=10
RATE_LIMIT_MFA_RECOVERY_WINDOW_SECONDS=3600
RATE_LIMIT_MFA_MANAGEMENT_MAX_ATTEMPTS=20
RATE_LIMIT_MFA_MANAGEMENT_WINDOW_SECONDS=3600
RATE_LIMIT_PERSONAL_DATA_EXPORT_MAX_ATTEMPTS=5
RATE_LIMIT_PERSONAL_DATA_EXPORT_WINDOW_SECONDS=3600
RATE_LIMIT_ACCOUNT_RESTORE_MAX_ATTEMPTS=5
RATE_LIMIT_ACCOUNT_RESTORE_WINDOW_SECONDS=3600
RATE_LIMIT_ROOM_SEND_MAX_ATTEMPTS=30
RATE_LIMIT_ROOM_SEND_WINDOW_SECONDS=60
RATE_LIMIT_ROOM_BROADCAST_MENTION_MAX_ATTEMPTS=5
RATE_LIMIT_ROOM_BROADCAST_MENTION_WINDOW_SECONDS=3600
RATE_LIMIT_ROOM_MENTIONABLE_USER_SEARCH_MAX_ATTEMPTS=120
RATE_LIMIT_ROOM_MENTIONABLE_USER_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_ROOM_PING_MAX_ATTEMPTS=30
RATE_LIMIT_ROOM_PING_WINDOW_SECONDS=60
RATE_LIMIT_ROOM_MESSAGE_MUTATION_MAX_ATTEMPTS=30
RATE_LIMIT_ROOM_MESSAGE_MUTATION_WINDOW_SECONDS=60
RATE_LIMIT_DIRECT_MESSAGE_SEND_MAX_ATTEMPTS=30
RATE_LIMIT_DIRECT_MESSAGE_SEND_WINDOW_SECONDS=60
RATE_LIMIT_DIRECT_MESSAGE_MUTATION_MAX_ATTEMPTS=30
RATE_LIMIT_DIRECT_MESSAGE_MUTATION_WINDOW_SECONDS=60
RATE_LIMIT_ATTACHMENT_UPLOAD_MAX_ATTEMPTS=10
RATE_LIMIT_ATTACHMENT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_DIRECT_MESSAGE_ATTACHMENT_UPLOAD_MAX_ATTEMPTS=10
RATE_LIMIT_DIRECT_MESSAGE_ATTACHMENT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_ROOM_INVITE_MAX_ATTEMPTS=60
RATE_LIMIT_ROOM_INVITE_WINDOW_SECONDS=3600
RATE_LIMIT_DIRECT_MESSAGE_USER_SEARCH_MAX_ATTEMPTS=120
RATE_LIMIT_DIRECT_MESSAGE_USER_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_MESSAGE_SEARCH_MAX_ATTEMPTS=60
RATE_LIMIT_MESSAGE_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_USER_SEARCH_MAX_ATTEMPTS=120
RATE_LIMIT_ADMIN_USER_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_ROOM_INVITABLE_USER_SEARCH_MAX_ATTEMPTS=120
RATE_LIMIT_ROOM_INVITABLE_USER_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_DIRECT_MESSAGE_USER_SEARCH_MAX_ATTEMPTS=120
RATE_LIMIT_ADMIN_DIRECT_MESSAGE_USER_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_DIRECT_MESSAGE_INSPECTION_MAX_ATTEMPTS=60
RATE_LIMIT_ADMIN_DIRECT_MESSAGE_INSPECTION_WINDOW_SECONDS=3600
RATE_LIMIT_MESSAGE_REVISION_REVIEW_MAX_ATTEMPTS=60
RATE_LIMIT_MESSAGE_REVISION_REVIEW_WINDOW_SECONDS=3600
RATE_LIMIT_MESSAGE_REPORT_MAX_ATTEMPTS=10
RATE_LIMIT_MESSAGE_REPORT_WINDOW_SECONDS=3600
RATE_LIMIT_MODERATION_QUEUE_MAX_ATTEMPTS=120
RATE_LIMIT_MODERATION_QUEUE_WINDOW_SECONDS=60
RATE_LIMIT_MODERATION_ACTION_MAX_ATTEMPTS=60
RATE_LIMIT_MODERATION_ACTION_WINDOW_SECONDS=3600

# Sensitive actions require the strongest factor configured for the account.
# Password-only accounts re-enter the current password. MFA accounts use a passkey or one-time recovery code.
# Successful verification remains valid only in the current PHP session for this many seconds.
PRIVILEGED_STEP_UP_MAX_AGE_SECONDS=600

# Passkeys remain disabled until both values are configured. Production origins must use HTTPS.
# RP ID is the lowercase DNS domain shared by the installation origin, without scheme or port.
# Example production pair:
# WEBAUTHN_RP_ID=chat.example.org
# WEBAUTHN_ORIGIN=https://chat.example.org
# Local development may use:
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:8080
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
MFA_PENDING_LOGIN_TTL_SECONDS=300

PRESENCE_LEASE_SECONDS=45
INACTIVITY_WARNING_SECONDS=60
SSE_CONNECTION_LEASE_SECONDS=40

# A successful destructive maintenance run older than this is shown as overdue.
MAINTENANCE_MAX_AGE_HOURS=26

# The Prometheus endpoint is disabled while this value is empty.
# Use at least 24 random characters and protect /metrics.php at the reverse proxy as well.
# METRICS_BEARER_TOKEN=replace-with-a-long-random-secret

# Defaults to the repository's var/uploads directory. Custom values must be absolute and outside public/.
# ATTACHMENT_STORAGE_PATH=/srv/chitchat/uploads
ATTACHMENT_MAX_BYTES=10485760

# Direct messages are not end-to-end encrypted and are retained permanently by default.
# Every successful administrative inspection is audited with actor, IP, reason, users and message range.
DM_ADMIN_INSPECTION_ENABLED=1
DM_ADMIN_INSPECTION_ROLE=super_admin

# Historical bodies from edits and deletions use a separate, opt-in authorization boundary.
# Every successful review requires a reason and is audited without copying message bodies into audit metadata.
MESSAGE_REVISION_REVIEW_ENABLED=0
MESSAGE_REVISION_REVIEW_ROLE=super_admin
